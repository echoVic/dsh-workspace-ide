{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "strictNullChecks": true
  },
  "include": [
    "src/client/*.js",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "lib/client.js",
    "node_modules"
  ]
}
