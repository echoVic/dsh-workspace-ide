{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "lib/index.js",
    "lib/host/**/*.js",
    "src/client/*.js",
    "scripts/*.mjs",
    "test/**/*.mjs",
    "test/**/*.js",
    "types/**/*.d.ts"
  ],
  "exclude": ["lib/client.js", "node_modules"]
}
