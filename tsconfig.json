{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "noImplicitAny": false
  },
  "include": [
    "lib/index.js",
    "lib/host/**/*.js",
    "src/client/*.js",
    "scripts/*.mjs",
    "test/**/*.mjs",
    "test/**/*.js",
    "types/**/*.d.ts",
    "src/client/*.ts",
    "src/client/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "build",
    "lib/client.js"
  ]
}
